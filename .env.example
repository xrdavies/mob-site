# Build-time public settings. These are NOT credentials.
# Export them before npm run build, or set GitHub Actions variables.
SITE_URL=https://mob.example.com
# Optional; defaults to https://dl.mymob.dev
DOWNLOAD_BASE_URL=https://dl.mymob.dev
# Optional App Store / TestFlight link; the iOS card shows "coming soon" until set.
IOS_APP_URL=
