---
// "A day away from your desk", seen through Mob's live view.
import Layout from '../layouts/Layout.astro';
import { install, siteURL } from '../data/site.mjs';
import HomePhone from '../components/HomePhone.astro';

// One entry per hour: the readout, the glow of the screen (RGB) and the phone panel all follow it.
const H = {
  morning: { turn: 'Turn 00', time: '08:30', place: 'Morning', glow: '255 186 120' },
  desk: { turn: 'Turn 01', time: '08:47', place: 'At the desk', glow: '255 196 140' },
  train: { turn: 'Turn 01', time: '09:12', place: 'On the train', glow: '255 160 110' },
  noon: { turn: 'Turn 02', time: '12:30', place: 'Lunch', glow: '150 200 255' },
  cafe: { turn: 'Turn 03', time: '15:05', place: 'A café', glow: '255 205 120' },
  dusk: { turn: 'Done', time: '18:00', place: 'Back at the desk', glow: '255 120 150' },
  night: { turn: 'Idle', time: '21:40', place: 'Night', glow: '139 125 255' },
};
// For search engines: what Mob is and where it runs. No ratings or prices beyond free.
const app = siteURL ? [{
  '@type': 'SoftwareApplication',
  name: 'Mob',
  description: 'Mob programming with your AI agents: mobd runs Codex, Claude Code and Pi on your own computer, and Mob on your laptop or phone sends them tasks, answers their questions and shows the live desktop.',
  url: `${siteURL}/`,
  downloadUrl: `${siteURL}/download/`,
  image: `${siteURL}/assets/social.png`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, iOS, Android',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/license/mit',
  codeRepository: 'https://github.com/xrdavies/mob',
}] : [];
const hour = (k: keyof typeof H) => ({ 'data-hour': k, 'data-turn': H[k].turn, 'data-time': H[k].time, 'data-place': H[k].place, 'data-glow': H[k].glow });
---
<Layout
  title="Mob · Steer Codex and Claude Code on your computer from your phone"
  description="Mob runs Codex, Claude Code and Pi on your own computer and lets you steer them from your phone or laptop: send tasks, answer questions, watch the live desktop."
  schema={app}
  readout={H.morning}
  room>

  <!-- 08:30 · Hero -->
  <section class="turn" {...hour('morning')}>
    <div class="wrapd">
      <p class="stamp"><b>08:30</b><span class="cap">A day with Mob · Tuesday</span></p>
      <h1 data-stream class="display caret mt-6 max-w-5xl text-[clamp(52px,8.5vw,124px)]">Leave the desk. <span class="text-accent-400">The work stays.</span></h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-[var(--dim)]">
        mobd keeps a coding agent working on your own computer while you're out. Mob is how it reaches you: it asks, you tap, it carries on.
        Here's an ordinary day.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#how" class="btn-light">How it works ↓</a>
        <a href="#desk" class="btn-ghost">A day with Mob</a>
      </div>
      <p class="mt-16 flex flex-wrap items-center gap-3"><span class="think font-mono text-sm">thinking…</span><span class="cap">Mob programming with your agents · Codex · Claude Code · Pi</span></p>
    </div>
  </section>

  <!-- How it works: the two parts and what you need, before the story -->
  <section id="how" class="border-t border-[var(--line)] py-24">
    <div class="wrapd">
      <p class="cap">How it works</p>
      <h2 class="mt-4 text-3xl sm:text-4xl">Two parts: mobd at the office, Mob with you.</h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-[var(--dim)]"><span class="text-white">Why “Mob”?</span> In <a href="https://en.wikipedia.org/wiki/Mob_programming" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:decoration-white">mob programming</a> a team works together on one computer: one at the keyboard, the others steering. Here the team is you and your agents, and you steer from anywhere.</p>
      <ol class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
        <li class="panel p-6">
          <p class="vcr text-[28px] text-accent-400">01</p>
          <h3 class="mt-2 text-lg font-medium">mobd on the office computer</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--dim)]">A Mac or a Linux machine that stays on. mobd runs Codex, Claude Code or Pi there, next to your code, tools and logins, and gives the agent a screen to work on.</p>
        </li>
        <li class="panel p-6">
          <p class="vcr text-[28px] text-accent-400">02</p>
          <h3 class="mt-2 text-lg font-medium">Mob on your devices</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--dim)]">Mob Desktop on your laptop, Mob Mobile on your iPhone or Android phone. Pair each once with a QR code from <code class="font-mono text-[13px]">mobd link</code>.</p>
        </li>
        <li class="panel p-6">
          <p class="vcr text-[28px] text-accent-400">03</p>
          <h3 class="mt-2 text-lg font-medium">Work from anywhere</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--dim)]">Send tasks, answer the agent's questions, watch its screen live and take control. On the office network, or from anywhere through Tailscale or Cloudflare.</p>
        </li>
      </ol>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="/start/" class="btn-light">Get started</a>
        <a href="/download/" class="btn-ghost">Download</a>
        <span class="cap">No server of ours in between · open source</span>
      </div>
    </div>
  </section>

  <!-- Features: the live view first -->
  <section id="features" class="border-t border-[var(--line)] py-24">
    <div class="wrapd">
      <p class="cap">What you can do</p>
      <h2 class="mt-4 text-3xl sm:text-4xl">Everything the agent does, from wherever you are.</h2>
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
        <article class="panel grid gap-6 p-6 md:col-span-3 md:grid-cols-[1fr_1.2fr] md:items-center">
          <div>
            <p class="flex items-center gap-2"><span class="live-dot"></span><span class="cap text-[var(--ok)]">Live view</span></p>
            <h3 class="mt-3 text-2xl font-medium">Watch the agent's screen. Take the wheel.</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-[var(--dim)]">See the office computer's screen live on your phone or laptop while the agent works. Switch to Control for a sign-in, a captcha or a click it can't make, then hand it back. WebRTC when it can, a WebSocket through tunnels; quality follows your connection.</p>
            <a href="/desktops/" class="mt-4 inline-block text-sm text-accent-400 hover:text-white">Desktops &amp; live view →</a>
          </div>
          <div class="overflow-hidden rounded-xl border border-[var(--line)] bg-black/40" aria-hidden="true">
            <div class="flex items-center gap-2 border-b border-[var(--line)] px-4 py-2"><span class="live-dot"></span><span class="vcr text-[15px]">Live · Control</span><span class="vcr ml-auto text-[15px] text-[var(--dim)]">1408×792 · 30 fps</span></div>
            <div class="relative grid place-items-center bg-[#16151d] p-8">
              <div class="w-52 rounded-xl border border-[var(--line)] bg-[#1d1c26] p-4">
                <p class="text-sm font-medium">Sign in to staging</p>
                <div class="mt-3 h-6 rounded-md border border-white/10"></div>
                <div class="mt-2 h-6 rounded-md border border-white/10"></div>
                <div class="mt-3 h-6 rounded-md bg-accent-400"></div>
              </div>
              <svg class="absolute bottom-8 left-[58%]" width="20" height="20" viewBox="0 0 24 24"><path d="M4 2l16 9-7 1.5L9.5 20z" fill="#fff" stroke="#0b0b0f" stroke-width="1.5"/></svg>
            </div>
          </div>
        </article>
        {[
          ['Questions and approvals', 'When the agent needs a decision or asks before a command, your phone buzzes. Answer from the notification.'],
          ['Codex, Claude Code or Pi', 'Choose per conversation. Models, effort and permissions are set once in Mob and shared by every device.'],
          ['Side by side on Linux', 'On Linux every conversation gets its own desktop, so several run at once. Idle ones sleep.'],
          ['From anywhere', 'On the office network, or through Tailscale or Cloudflare. One computer can have a LAN and a remote address.'],
          ['Steer it as it works', 'Add to a running Codex or Pi turn without stopping it, or stop any turn. Every reply, command and edit stays in the conversation, on every device.'],
          ['Private and open source', 'Your devices talk to your computer; there is no server of ours in between. MIT licensed.'],
        ].map(([t, d]) => (
          <article class="panel p-6"><h3 class="text-lg font-medium">{t}</h3><p class="mt-2 text-[15px] leading-relaxed text-[var(--dim)]">{d}</p></article>
        ))}
      </div>
    </div>
  </section>

  <!-- 08:47 · At the desk -->
  <section id="desk" class="turn" {...hour('desk')}>
    <div class="wrapd grid grid-cols-1 items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="stamp"><b>08:47</b><span class="cap">At the desk · Office computer</span></p>
        <h2 data-stream class="display mt-6 text-[clamp(44px,5.5vw,76px)]">Hand it over.</h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[var(--dim)]">
          One sentence. Codex, Claude Code or Pi runs right here, next to your files, your tools and your logins. Then pick up your coat.
        </p>
      </div>
      <div class="min-w-0 space-y-4" aria-hidden="true">
        <p class="ml-auto w-fit max-w-sm rounded-2xl rounded-br-md bg-accent-400 px-4 py-3 text-[15px] text-white shadow-[0_10px_40px_-10px_rgb(139_125_255/.7)]">Fix the login error and run the tests. Ask me before you deploy.</p>
        <div class="panel p-5">
          <p class="flex items-center justify-between"><span class="cap">Codex · Turn 01</span><span class="think font-mono text-xs">working</span></p>
          <div data-steps class="mt-3">
            <p class="step"><i></i><span>read src/pages/login.ts</span></p>
            <p class="step" data-result="fail"><i></i><span>npm test -- login <em class="not-italic text-[#ff8a8a]">· 1 failed</em></span></p>
            <p class="step"><i></i><span>edit src/pages/login.ts <em class="not-italic text-[var(--ok)]">+3</em> <em class="not-italic text-[#ff8a8a]">−1</em></span></p>
            <p class="step"><i></i><span>npm test <em class="not-italic text-[var(--dim)]">· 48 passed</em></span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09:12 · On the train -->
  <section class="turn" {...hour('train')}>
    <div class="wrapd grid grid-cols-1 items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="stamp"><b>09:12</b><span class="cap">On the train · iPhone</span></p>
        <h2 data-stream class="display mt-6 text-[clamp(44px,5.5vw,76px)]">It asks. <span class="text-accent-400">You tap.</span></h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[var(--dim)]">
          When the agent needs a decision, your phone buzzes. Four seconds of your morning, and it's back to work.
          <span class="hidden min-[1440px]:inline">Go on: answer it on the phone.</span>
        </p>
        <!-- On small screens the question lives here; on large ones, on the phone in the corner. -->
        <div data-question class="panel mt-8 p-4 min-[1440px]:hidden">
          <p class="cap text-[#ffc98a]">Codex asks</p>
          <p class="mt-1">48 tests pass. Deploy this build?</p>
          <div class="mt-3 flex flex-wrap gap-2"><button type="button" data-answer="Staging" class="btn-light min-h-9 px-4">Staging</button><button type="button" data-answer="Production" class="btn-ghost min-h-9 px-4">Production</button><button type="button" data-answer="Not yet" class="btn-ghost min-h-9 px-4">Not yet</button></div>
        </div>
        <p data-answered hidden class="mt-8 font-mono text-sm text-[var(--ok)] min-[1440px]:hidden">✓ Answered: <b class="font-normal">Staging</b></p>
      </div>
      <div class="panel min-w-0 p-5" aria-hidden="true">
        <p class="flex items-center justify-between"><span class="cap">Codex · Turn 01</span><span class="font-mono text-xs text-[#ffc98a]">needs you</span></p>
        <div data-steps class="mt-3">
          <p class="step" data-done><i></i><span>npm test <em class="not-italic text-[var(--dim)]">· 48 passed</em></span></p>
          <p class="step" data-hold data-waiting><i></i><span class="text-[#ffc98a]">Waiting for your answer</span></p>
          <p class="step" data-hold data-after-answer hidden><i></i><span>npm run deploy -- staging</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 12:30 · Lunch -->
  <section class="turn" {...hour('noon')}>
    <div class="wrapd">
      <p class="stamp"><b>12:30</b><span class="cap">Lunch · Live view</span></p>
      <h2 data-stream class="display mt-6 max-w-3xl text-[clamp(44px,5.5vw,76px)]">Watch the screen it's using.</h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-[var(--dim)]">The agent's desktop, live, between two bites: the Mac's own screen, or on Linux a desktop of the conversation's own. Streamed over WebRTC at whatever quality your connection allows.</p>
      <div class="panel mt-14 overflow-hidden" aria-hidden="true">
        <div class="flex items-center gap-3 border-b border-[var(--line)] px-5 py-3">
          <span class="live-dot"></span><span class="vcr text-[17px]">Live · view only</span>
          <span class="vcr ml-auto hidden text-[17px] text-[var(--dim)] sm:inline">1408×792 · 30 fps · LAN</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[1.15fr_1fr]">
          <pre class="overflow-x-auto bg-black/40 p-6 font-mono text-[12.5px] leading-6 text-[#c9c7d9]"><span class="text-[var(--dim)]">$ npm test -- login</span>
<span class="bg-[#ff8a8a] px-1 text-black">FAIL</span> src/pages/login.test.ts
<span class="text-[#ffb3b3]">  TypeError: Cannot read 'trim' of undefined</span>

<span class="text-[var(--dim)]">$ npm test</span>
<span class="bg-[var(--ok)] px-1 text-black">PASS</span> src/pages/login.test.ts
<span class="bg-[var(--ok)] px-1 text-black">PASS</span> src/api/session.test.ts
Tests: <span class="text-[var(--ok)]">48 passed</span>, 48 total</pre>
          <div class="hidden place-items-center bg-[#16151d] p-8 sm:grid">
            <div class="w-56 rounded-xl border border-[var(--line)] bg-[#1d1c26] p-5">
              <p class="text-sm font-medium">Sign in</p>
              <div class="mt-3 h-7 rounded-md border border-white/10"></div>
              <div class="mt-2 h-7 rounded-md border border-white/10"></div>
              <div class="mt-3 h-7 rounded-md bg-accent-400"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 15:05 · A café -->
  <section class="turn" {...hour('cafe')}>
    <div class="wrapd grid grid-cols-1 items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="stamp"><b>15:05</b><span class="cap">A café · Laptop</span></p>
        <h2 data-stream class="display mt-6 text-[clamp(44px,5.5vw,76px)]">Take the wheel, <span class="text-accent-400">briefly.</span></h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-[var(--dim)]">
          Some things need a human: a login, a captcha, one click the agent can't make. Switch to Control, take the mouse and keyboard from here, switch back.
        </p>
      </div>
      <div class="panel min-w-0 p-5" aria-hidden="true">
        <div class="flex items-center gap-3"><span class="cap">Mode</span>
          <span class="rounded-full bg-white/5 p-1 text-sm"><span class="rounded-full px-3 py-1 text-[var(--dim)]">View</span><span class="rounded-full bg-accent-400 px-3 py-1 text-white">Control</span></span>
        </div>
        <div class="relative mt-5 grid place-items-center rounded-xl bg-[#16151d] p-10">
          <div class="w-56 rounded-xl border border-[var(--line)] bg-[#1d1c26] p-5">
            <p class="text-sm font-medium">Verify it's you</p>
            <p class="mt-3 flex items-center gap-2 rounded-md border border-white/10 px-2 py-1.5 text-xs"><span class="size-3.5 rounded-sm bg-accent-400"></span>I'm not a robot</p>
          </div>
          <svg class="absolute bottom-12 left-[56%]" width="22" height="22" viewBox="0 0 24 24"><path d="M4 2l16 9-7 1.5L9.5 20z" fill="#fff" stroke="#0b0b0f" stroke-width="1.5"/></svg>
        </div>
        <p class="vcr mt-4 text-[16px] text-[var(--dim)]">Keys go to the office computer · Esc to stop</p>
      </div>
    </div>
  </section>

  <!-- 18:00 · Back at the desk -->
  <section class="turn" {...hour('dusk')}>
    <div class="wrapd">
      <p class="stamp"><b>18:00</b><span class="cap">Back at the desk</span></p>
      <h2 data-stream class="display mt-6 max-w-4xl text-[clamp(48px,7vw,104px)]">It's done. <span class="text-accent-400">Your laptop never moved.</span></h2>
      <dl class="mt-16 grid max-w-4xl grid-cols-2 gap-px overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--line)] sm:grid-cols-4">
        {[['Turns', '4'], ['Questions', '1'], ['Tests passing', '48'], ['Minutes of yours', '6']].map(([k, v]) => (
          <div class="bg-[#0f0f15] p-6"><dt class="cap">{k}</dt><dd class="vcr mt-2 text-[64px] leading-none text-white">{v}</dd></div>
        ))}
      </dl>
      <p class="mt-10 max-w-lg text-lg leading-relaxed text-[var(--dim)]">Every reply, command and file edit is in the conversation, on every device. Read it over, or start the next one.</p>
    </div>
  </section>

  <!-- 21:40 · Night -->
  <section class="turn text-center" {...hour('night')}>
    <div class="wrapd">
      <img src="/assets/logo.svg" width="64" height="64" alt="" class="mx-auto">
      <p class="vcr mt-6 text-[20px] tracking-[.3em] text-[var(--dim)]">End of day · Turn complete</p>
      <h2 data-stream class="display caret mx-auto mt-6 max-w-4xl text-[clamp(52px,8vw,120px)]">Still working. <span class="text-accent-400">Go home.</span></h2>
      <p class="mx-auto mt-6 max-w-lg text-lg leading-relaxed text-[var(--dim)]">Set up the office computer in ten minutes. Everything runs on your machines; there's no server of ours in between. Mob is open source (MIT): <a href="https://github.com/xrdavies" rel="noreferrer" class="underline decoration-white/30 underline-offset-4 hover:decoration-white">read every line on GitHub</a>.</p>
      <div class="panel mx-auto mt-10 flex max-w-2xl items-center gap-3 px-5 py-4 text-left">
        <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-sm"><span class="text-accent-400">$ </span><span data-copy-source>{install}</span></code>
        <button type="button" data-copy class="cap shrink-0 rounded-full border border-white/15 px-3 py-1.5 hover:border-white/40">Copy</button>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/download/" class="btn-light">Download</a>
        <a href="/start/" class="btn-ghost">Read the guide</a>
      </div>
      <p class="cap mt-12">mobd for macOS and Linux · Mob Desktop for macOS · Mob Mobile for iPhone, iPad and Android, soon · more on the way</p>
      <div class="mx-auto mt-16 max-w-md border-t border-[var(--line)] pt-8">
        <p class="vcr text-[18px] tracking-[.25em] text-[var(--dim)]">Keep the computer on. Turn the screen off.</p>
        <button type="button" data-sleep class="btn-ghost mt-4">Put the display to sleep</button>
      </div>
    </div>
  </section>

  <Fragment slot="overlay">
    <HomePhone />

    <div class="zzz">
      <div class="text-center">
        <p class="vcr text-[28px] tracking-[.3em] text-[#5f5d72]">Display asleep · mobd still running</p>
        <button type="button" data-wake class="btn-ghost mt-6 text-[#cfcde0]">Wake it</button>
      </div>
    </div>
  </Fragment>
</Layout>
