---
import Layout from '../layouts/Layout.astro';
import AppMock from '../components/AppMock.astro';
import Command from '../components/Command.astro';
import PhoneMock from '../components/PhoneMock.astro';
import { install, ios, latest } from '../data/site.mjs';

const pill = [['mob', 'Mob'], ['mobd', 'mobd']].filter(([p]) => latest(p)).map(([p, name]) => `${name} ${latest(p).version}`).join(' · ');
const office = [['macOS', !!latest('mobd')], ['Linux', false], ['Windows', false]];
const clients = [['macOS', !!latest('mob')], ['iPhone & iPad', !!ios], ['Android', !!latest('android')], ['Windows', false], ['Linux', false]];
---
<Layout
  title="Mob · Work with AI agents on your desktop, from anywhere"
  description="mobd runs coding agents such as Codex and Claude Code on your own computer. Mob lets you send tasks, answer questions and watch the live desktop from your laptop or phone.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div class="glow absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative pt-20 text-center sm:pt-28">
      {pill && <a href="/download/" class="tag-accent mb-8 normal-case tracking-normal hover:border-cyan-400/60"><span class="size-1.5 rounded-full bg-cyan-400"></span>New release · {pill} →</a>}
      <h1 class="mx-auto max-w-4xl text-4xl leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">Work with AI agents on your desktop, <span class="bg-gradient-to-r from-cyan-300 to-emerald-300 bg-clip-text text-transparent">from anywhere.</span></h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-400">
        mobd runs coding agents on your own computer, next to your files, tools and desktop. Mob puts them in your pocket: send tasks, answer their questions and watch the live desktop.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/download/" class="btn-primary h-12 px-6 text-[15px]">Download</a>
        <a href="/start/" class="btn-secondary h-12 px-6 text-[15px]">Get started <span aria-hidden="true">→</span></a>
      </div>
      <p class="mt-8 font-mono text-xs uppercase tracking-[0.2em] text-zinc-500">
        Works with <span class="text-zinc-300">Codex</span> · <span class="text-zinc-300">Claude Code</span> · more agents soon
      </p>
    </div>
    <div class="container-x relative mt-16 pb-24">
      <AppMock />
      <div class="absolute -bottom-16 -left-2 hidden xl:block"><PhoneMock /></div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="container-x pt-36">
    <div class="max-w-2xl">
      <p class="eyebrow">How it works</p>
      <h2 class="section-title">Three commands to your first task.</h2>
    </div>
    <ol class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
      <li class="card p-6">
        <span class="font-mono text-xs text-cyan-400">01 · office computer</span>
        <h3 class="mt-2 text-lg">Install mobd</h3>
        <p class="mt-1 text-sm text-zinc-400">It runs the agents and keeps your conversations.</p>
        <pre class="term term-body mt-5"><span class="prompt">$ </span>curl -fsSL …/install.sh | sh
<span class="prompt">$ </span>mobd init
<span class="prompt">$ </span>mobd start</pre>
      </li>
      <li class="card p-6">
        <span class="font-mono text-xs text-cyan-400">02 · office computer</span>
        <h3 class="mt-2 text-lg">Create a pairing link</h3>
        <p class="mt-1 text-sm text-zinc-400">One-time, valid for ten minutes.</p>
        <pre class="term term-body mt-5"><span class="prompt">$ </span>mobd link --url http://…:8080
<span class="text-emerald-300">✓ </span><span class="muted">QR code and link printed</span>
<span class="muted">  scan or paste it in Mob</span></pre>
      </li>
      <li class="card p-6">
        <span class="font-mono text-xs text-cyan-400">03 · your device</span>
        <h3 class="mt-2 text-lg">Hand off a task</h3>
        <p class="mt-1 text-sm text-zinc-400">Describe the job in a sentence.</p>
        <div class="term term-body mt-5 font-sans">
          <p class="ml-auto w-fit rounded-xl bg-zinc-800 px-3 py-1 text-zinc-100">Fix the login error.</p>
          <p class="mt-2 flex items-center gap-2 font-mono text-xs text-emerald-300"><span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>agent is working</p>
        </div>
      </li>
    </ol>
  </section>

  <!-- Features: bento -->
  <section id="features" class="container-x pt-36">
    <div class="max-w-2xl">
      <p class="eyebrow">Features</p>
      <h2 class="section-title">Stay in the loop without sitting at the desk.</h2>
      <p class="section-lead">The agent keeps working on your computer. You keep up from wherever you are.</p>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-6">
      <article class="card overflow-hidden lg:col-span-4">
        <div class="p-7 pb-0">
          <p class="eyebrow">Live view</p>
          <h3 class="mt-2 text-2xl">Watch the desktop it works on.</h3>
          <p class="mt-2 max-w-lg text-zinc-400">The office desktop streams over WebRTC at a quality that follows your network. Switch to control and use the mouse and keyboard yourself.</p>
        </div>
        <div class="mt-7 px-7" aria-hidden="true">
          <div class="overflow-hidden rounded-t-xl border border-b-0 border-zinc-800 bg-[#1e1f29]">
            <div class="flex items-center gap-2 bg-zinc-800/80 px-3 py-1.5 text-[11px] text-zinc-400"><span class="size-1.5 rounded-full bg-emerald-400"></span>Live <span class="ml-auto font-mono">1408×792 · 30 fps · WebRTC</span></div>
            <div class="grid grid-cols-1 sm:grid-cols-[1.1fr_1fr]">
              <div class="space-y-1 p-4 font-mono text-[11px] leading-snug">
                <p class="text-zinc-400">$ npm test -- login</p>
                <p><span class="bg-rose-500 px-1 text-black">FAIL</span> <span class="text-zinc-400">src/pages/login.test.ts</span></p>
                <p class="text-rose-300/80">  TypeError: Cannot read 'trim' of undefined</p>
                <p class="pt-2 text-zinc-400">$ npm test</p>
                <p><span class="bg-emerald-500 px-1 text-black">PASS</span> <span class="text-zinc-400">src/pages/login.test.ts</span></p>
                <p class="text-zinc-400">Tests: <span class="text-emerald-400">48 passed</span></p>
              </div>
              <div class="hidden border-l border-zinc-700/60 bg-zinc-100 p-4 sm:block">
                <div class="mx-auto max-w-[180px] rounded-lg bg-white p-3 shadow">
                  <p class="text-xs font-semibold text-zinc-800">Sign in</p>
                  <div class="mt-2 h-5 rounded border border-zinc-300"></div>
                  <div class="mt-1.5 h-5 rounded border border-rose-300"></div>
                  <p class="mt-1 text-[9px] text-rose-500">Enter your password</p>
                  <div class="mt-2 h-5 rounded bg-indigo-500"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
      <article class="card flex flex-col p-7 lg:col-span-2">
        <p class="eyebrow">Approvals</p>
        <h3 class="mt-2 text-2xl">It asks before it acts.</h3>
        <p class="mt-2 text-zinc-400">A notification reaches whichever device you have. Answer in a tap and the work continues.</p>
        <div class="mt-8 rounded-xl border border-amber-500/30 bg-amber-500/[0.06] p-4 pt-3 lg:mt-auto" aria-hidden="true">
          <p class="font-mono text-[10px] uppercase tracking-wider text-amber-300">Approval needed</p>
          <p class="mt-1 text-sm text-zinc-100">Run <code class="font-mono text-cyan-200">npm run deploy -- staging</code>?</p>
          <div class="mt-3 flex gap-2 text-xs"><span class="rounded-md bg-cyan-400 px-3 py-1 font-medium text-zinc-950">Allow</span><span class="rounded-md border border-zinc-700 px-3 py-1 text-zinc-300">Deny</span></div>
        </div>
      </article>
      <article class="card flex flex-col p-7 lg:col-span-2">
        <p class="eyebrow">Timeline</p>
        <h3 class="mt-2 text-2xl">Every step in the open.</h3>
        <p class="mt-2 text-zinc-400">Commands, edits and tool calls arrive as they happen. Follow up or stop the turn any time.</p>
        <ul class="mt-6 space-y-2 border-l border-zinc-800 pl-4 font-mono text-xs text-zinc-400" aria-hidden="true">
          <li><span class="text-zinc-500">Plan</span> · 3 steps</li>
          <li><span class="text-rose-400">✕</span> npm test -- login</li>
          <li><span class="text-emerald-400">✓</span> edit src/pages/login.ts</li>
          <li><span class="text-emerald-400">✓</span> npm test · 48 passed</li>
        </ul>
      </article>
      <article class="card flex flex-col p-7 lg:col-span-2">
        <p class="eyebrow">Pairing</p>
        <h3 class="mt-2 text-2xl">Paired per device.</h3>
        <p class="mt-2 text-zinc-400">Each phone or laptop pairs once with a one-time link, and can be revoked on its own.</p>
        <pre class="term term-body mt-6" aria-hidden="true"><span class="prompt">$ </span>mobd clients list
<span class="muted">ID      NAME</span>
c1a9    iPhone
f72e    MacBook Air
<span class="prompt">$ </span>mobd clients revoke f72e</pre>
      </article>
      <article class="card flex flex-col p-7 lg:col-span-2">
        <p class="eyebrow">Direct</p>
        <h3 class="mt-2 text-2xl">No middleman.</h3>
        <p class="mt-2 text-zinc-400">Devices reach mobd over your LAN, a VPN or Tailscale. Code and conversations stay on your computer; we run no server that sees them.</p>
        <div class="mt-8 flex items-center gap-3 font-mono text-xs text-zinc-400 lg:mt-auto" aria-hidden="true">
          <span class="rounded-md border border-zinc-700 px-2 py-1">phone</span>
          <span class="h-px flex-1 bg-gradient-to-r from-cyan-400/60 to-emerald-400/60"></span>
          <span class="rounded-md border border-zinc-700 px-2 py-1">mobd</span>
        </div>
      </article>
    </div>
  </section>

  <!-- Platforms -->
  <section id="everywhere" class="container-x pt-36">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Platforms</p>
        <h2 class="section-title">Your computer, any device.</h2>
        <p class="section-lead">Start a task at your desk, answer its question on the train, check the result on your tablet. Every client shares the same conversations.</p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {[['Office computer', 'mobd', office], ['Your devices', 'Mob', clients]].map(([title, name, list]) => (
          <div class="card p-5">
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-500">{title} · <span class="text-zinc-300">{name}</span></p>
            <ul class="mt-4 space-y-2.5 text-sm">
              {list.map(([os, ready]) => <li class="flex items-center justify-between gap-3"><span class={ready ? 'text-zinc-100' : 'text-zinc-500'}>{os}</span><span class={ready ? 'tag-live' : 'tag-soon'}>{ready ? 'Available' : 'Soon'}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="container-x pt-36">
    <div class="relative overflow-hidden rounded-3xl border border-zinc-800 px-6 py-16 text-center sm:px-16">
      <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
      <div class="glow absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="text-3xl sm:text-5xl">Ready in ten minutes.</h2>
        <p class="mx-auto mt-4 max-w-xl text-zinc-400">Run this on the Mac that should do the work, then follow the guide.</p>
        <div class="mx-auto mt-8 max-w-2xl text-left"><Command command={install} /></div>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/start/" class="btn-primary">Get started</a>
          <a href="/download/" class="btn-secondary">All downloads</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
