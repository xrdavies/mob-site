---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found · Mob" description="This page does not exist.">
  <section class="container-x pt-32 text-center">
    <p class="font-mono text-sm text-cyan-400">404</p>
    <h1 class="mt-3 text-4xl">Page not found.</h1>
    <p class="mt-4 text-zinc-400">The page moved or never existed.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Home</a>
      <a href="/download/" class="btn-secondary">Download</a>
    </div>
  </section>
</Layout>
