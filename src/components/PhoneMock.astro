---
// A phone lock screen with Mob's question notification, drawn in HTML.
---
<div class="w-[230px] rounded-[2.4rem] border border-zinc-700 bg-black p-2 shadow-2xl shadow-black/80 ring-1 ring-white/10" aria-hidden="true">
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-b from-zinc-800 via-zinc-900 to-zinc-950 px-3 pb-6 pt-3">
    <div class="mx-auto h-5 w-20 rounded-full bg-black"></div>
    <p class="mt-6 text-center text-4xl font-light text-zinc-100">9:41</p>
    <p class="text-center text-[11px] text-zinc-400">Thursday, October 22</p>
    <div class="mt-8 rounded-2xl bg-zinc-700/60 p-3 text-left backdrop-blur">
      <div class="flex items-center gap-1.5 text-[10px] text-zinc-300"><img src="/assets/app-icon.svg" width="14" height="14" alt="" class="rounded">Mob<span class="ml-auto text-zinc-400">now</span></div>
      <p class="mt-1 text-[12px] font-semibold text-zinc-50">Codex asks · Fix login error</p>
      <p class="text-[12px] leading-snug text-zinc-200">Tests pass. Deploy this build?</p>
    </div>
    <div class="mt-2 grid grid-cols-3 gap-1.5 text-center text-[11px] text-zinc-100">
      <span class="rounded-xl bg-zinc-700/60 py-1.5">Staging</span><span class="rounded-xl bg-zinc-700/60 py-1.5">Production</span><span class="rounded-xl bg-zinc-700/60 py-1.5">Not yet</span>
    </div>
    <div class="mx-auto mt-16 h-1 w-24 rounded-full bg-zinc-500"></div>
  </div>
</div>
