---
// A product's latest release in one fold: notes, the checksum of each file, and its GitHub release.
import { renderNotes } from '../../lib/config.mjs';
import { latest, releasePage, releasesPage } from '../data/site.mjs';

interface Props { product: string }
const { product } = Astro.props;
const release = latest(product);
const name = (url: string) => url.slice(url.lastIndexOf('/') + 1);
// The main download first, then the others, each once.
const files = release ? [{ url: release.url, sha256: release.sha256 }, ...Object.values(release.files).flat()]
  .filter((f, i, all) => all.findIndex(g => g.url === f.url) === i) : [];
---
{release && (
  <details class="fold">
    <summary>Release notes and checksums</summary>
    <div class="grid gap-3">
      <div class="release-notes" set:html={renderNotes(release.notes || `${product} ${release.version}`)} />
      <dl class="grid gap-1.5">
        {files.map(f => <div><dt class="font-mono text-xs text-zinc-300">{name(f.url)}</dt><dd class="break-all font-mono text-[11px] text-zinc-500">{f.sha256}</dd></div>)}
      </dl>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <a class="link" href={release.checksums}>SHA256SUMS ↗</a>
        <a class="link" href={releasePage(product, release.version)} rel="noreferrer">v{release.version} on GitHub ↗</a>
        <a class="link" href={releasesPage(product)} rel="noreferrer">All releases ↗</a>
      </p>
      <slot />
    </div>
  </details>
)}
