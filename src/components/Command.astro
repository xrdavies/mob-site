---
// A one-line shell command with a copy button (the button works with JavaScript only).
interface Props { command: string; label?: string }
const { command, label } = Astro.props;
---
<div class="term">
  {label && <div class="term-bar justify-between"><span class="font-sans text-xs text-zinc-500">{label}</span></div>}
  <div class="flex items-center gap-3 px-4 py-3">
    <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-zinc-200"><span class="prompt">$ </span><span data-copy-source>{command}</span></code>
    <button type="button" data-copy class="shrink-0 rounded-md border border-zinc-700 px-2.5 py-1 font-sans text-xs text-zinc-300 hover:border-zinc-500 hover:text-zinc-50">Copy</button>
  </div>
</div>
