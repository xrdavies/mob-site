---
import '../styles/global.css';
import { latest, siteURL } from '../data/site.mjs';
import { DOC_PATHS } from '../data/docs.mjs';

interface Props {
  title: string;
  description: string;
  /** Header readout: on the home page it follows the hour; elsewhere it names the page. */
  readout?: { turn: string; time: string; place: string };
  /** Home: leave the right edge free for the phone on large screens. */
  room?: boolean;
}
const { title, description, readout = { turn: 'Mob', time: '', place: '' }, room = false } = Astro.props;
const path = Astro.url.pathname;
const mob = latest('mob')?.version;
const mobd = latest('mobd')?.version;
const versions = [mob && `Mob ${mob}`, mobd && `mobd ${mobd}`].filter(Boolean).join(' · ');
// Docs is current on every docs page.
const docs = DOC_PATHS.includes(path);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {/* The dev server injects inline styles and scripts; the built site has none. */}
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'">}
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0b0b0f">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  {siteURL && <link rel="canonical" href={`${siteURL}${path}`}>}
  {siteURL && <meta property="og:url" content={`${siteURL}${path}`}>}
  {siteURL && <meta property="og:image" content={`${siteURL}/assets/social.png`}>}
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-6 focus:z-[70] focus:rounded-md focus:bg-zinc-900 focus:px-3 focus:py-2">Skip to content</a>

  <!-- The office computer's screen, as Mob's live view shows it -->
  <div class="hourglow" aria-hidden="true"></div>
  <div class="scan" aria-hidden="true"></div>
  <div class="bezel" aria-hidden="true">
    <div class="absolute -top-[11px] left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-full bg-[#0b0b0f] px-3">
      <span class="live-dot"></span><span class="vcr text-[15px] text-[#cfcde0]">Live · Office computer<span class="hidden sm:inline"> · WebRTC</span></span>
    </div>
    <div class="absolute -bottom-[11px] left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-[#0b0b0f] px-3 sm:block">
      <span class="vcr text-[15px] text-[#6d6b80]">Mob · steer it from anywhere</span>
    </div>
  </div>

  <div class="screen">
    <header class={`${room ? 'room ' : ''}fixed inset-x-2 top-2 z-40 rounded-t-[18px] bg-[#0b0b0f]/75 backdrop-blur-md sm:inset-x-[14px] sm:top-[14px] sm:rounded-t-[26px]`}>
      <div class="wrapd flex h-16 items-center justify-between gap-4 sm:h-[72px]">
        <a href="/" class="flex items-center gap-2.5 text-[16px] font-semibold"><img src="/assets/logo.svg" width="24" height="24" alt="">Mob</a>
        <div class="hidden items-baseline gap-3 md:flex" aria-live="polite">
          <span data-read-turn class="vcr text-[18px] text-accent-400">{readout.turn}</span>
          <span data-read-time class="vcr text-[26px] leading-none">{readout.time}</span>
          <span data-read-place class="cap">{readout.place}</span>
        </div>
        <nav aria-label="Main" class="flex items-center gap-5 text-sm">
          <a href="/start/" aria-current={docs ? 'page' : undefined} class="text-[var(--dim)] hover:text-white aria-[current=page]:text-white">Docs</a>
          <a href="https://github.com/xrdavies" rel="noreferrer" class="hidden text-[var(--dim)] hover:text-white sm:inline">GitHub</a>
          <button type="button" data-search-open aria-label="Search the docs" class="flex items-center gap-2 rounded-full border border-white/15 px-3 py-1.5 text-[var(--dim)] hover:border-white/40 hover:text-white">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <span class="hidden md:inline">Search</span><kbd class="hidden rounded border border-white/15 px-1 font-mono text-[11px] md:inline">/</kbd>
          </button>
          <a href="/download/" class="btn-light min-h-9 px-4">Download</a>
        </nav>
      </div>
    </header>

    <main id="main" class={room ? 'room' : ''}><slot /></main>

    <footer class={`${room ? 'room ' : ''}border-t border-[var(--line)]`}>
      <div class="wrapd flex flex-col gap-4 pb-6 pt-10 sm:flex-row sm:items-center sm:justify-between">
        <p class="vcr text-[16px] text-[var(--dim)]">{versions || 'Mob'}</p>
        <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-[var(--dim)]">
          <a href="/download/" class="hover:text-white">Download</a>
          <a href="/start/" class="hover:text-white">Docs</a>
          <a href="/remote/" class="hover:text-white">Remote access</a>
          <a href="/privacy/" class="hover:text-white">Privacy</a>
          <a href="/faq/#report" class="hover:text-white">Report a problem</a>
          <a href="https://github.com/xrdavies" rel="noreferrer" class="hover:text-white">Source code</a>
        </nav>
      </div>
      <p class="wrapd pb-16 font-mono text-xs text-zinc-600">© 2026 Mob · Open source, <a href="https://github.com/xrdavies/mob/blob/main/LICENSE" rel="noreferrer" class="hover:text-white">MIT License</a></p>
    </footer>
  </div>

  <dialog data-search aria-label="Search the docs" class="search">
    <form method="dialog" class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="shrink-0 text-zinc-500" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="Search the docs (e.g. firewall, pair, Pi)" aria-label="Search" autocomplete="off" class="min-w-0 flex-1 bg-transparent text-[15px] text-zinc-100 outline-none placeholder:text-zinc-500">
      <button class="shrink-0 rounded border border-white/15 px-1.5 font-mono text-[11px] text-zinc-500 hover:text-zinc-200" aria-label="Close">Esc</button>
    </form>
    <div data-search-results class="max-h-[60vh] overflow-y-auto p-2" aria-live="polite"></div>
  </dialog>

  <slot name="overlay" />
  <script src="../scripts/site.ts"></script>
</body>
</html>
