---
// A docs page: the list of all docs pages with this page's sections under it, then the article.
import Layout from './Layout.astro';
import { DOCS, DOC_PATHS } from '../data/docs.mjs';

interface Props {
  title: string;
  description: string;
  /** Lead under the heading. */
  lead?: string;
  /** This page's sections: [id, label]. */
  sections?: [string, string][];
}
const { title, description, lead, sections = [] } = Astro.props;
const path = Astro.url.pathname;
const i = DOC_PATHS.indexOf(path);
const all = DOCS.flatMap(g => g.pages);
const prev = i > 0 ? all[i - 1] : undefined;
const next = i >= 0 && i < all.length - 1 ? all[i + 1] : undefined;
---
<Layout title={`${title} · Mob`} description={description} readout={{ turn: 'Docs', time: '', place: title }}>
  <div class="container-x grid grid-cols-1 gap-12 pt-28 lg:grid-cols-[230px_minmax(0,1fr)] lg:pt-36">
    <details data-mobile-toc class="fold sticky top-[72px] z-30 rounded-xl bg-[#0b0b0f]/95 backdrop-blur lg:hidden">
      <summary>Docs · {title}</summary>
      <nav aria-label="Docs (mobile)" class="grid gap-1 pb-3 text-sm">
        {DOCS.map(g => <>
          <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-500">{g.group}</p>
          {g.pages.map(([href, label]) => <a href={href} aria-current={href === path ? 'page' : undefined} class="py-1 text-zinc-300 aria-[current=page]:text-accent-400">{label}</a>)}
        </>)}
      </nav>
    </details>

    <aside class="hidden lg:block">
      <nav data-doc-nav aria-label="Docs" class="sticky top-32 max-h-[calc(100vh-10rem)] overflow-y-auto text-sm">
        {DOCS.map((g, n) => <>
          <p class={`${n ? 'mt-7 ' : ''}font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-500`}>{g.group}</p>
          <div class="mt-3 grid gap-0.5">
            {g.pages.map(([href, label]) => <>
              <a href={href} aria-current={href === path ? 'page' : undefined} class="rounded-md px-2 py-1.5 text-zinc-400 hover:text-zinc-100 aria-[current=page]:text-zinc-50">{label}</a>
              {href === path && sections.length > 0 && <div class="mb-1 ml-2 grid gap-0.5 border-l border-white/[0.08] pl-2">
                {sections.map(([id, s]) => <a href={`#${id}`} class="rounded-md px-2 py-1 text-[13px] text-zinc-500 hover:text-zinc-100 data-[active]:bg-white/[0.06] data-[active]:text-zinc-50">{s}</a>)}
              </div>}
            </>)}
          </div>
        </>)}
      </nav>
    </aside>

    <article class="doc max-w-3xl">
      <header class="mb-14">
        <p class="eyebrow">Docs</p>
        <h1 class="mt-3 text-4xl">{title}</h1>
        {lead && <p class="mt-4 text-lg text-zinc-400" set:html={lead} />}
      </header>
      <slot />
      {(prev || next) && <nav aria-label="Previous and next" class="mt-20 flex flex-wrap justify-between gap-4 border-t border-white/[0.08] pt-8 text-sm">
        {prev ? <a href={prev[0]} class="text-zinc-400 hover:text-zinc-100">← {prev[1]}</a> : <span></span>}
        {next && <a href={next[0]} class="text-zinc-400 hover:text-zinc-100">{next[1]} →</a>}
      </nav>}
    </article>
  </div>
</Layout>
